    logo: 'UniversityofMichigan.png',
  },
  {
    component: 'Tool and Technology Development',
    awardee: 'Fritz Sedlazeck (Contact) and Tao Wu',
    institution: 'Baylor College of Medicine',
    title:
      'Identification of somatic/ mosaic SV and transposon activity and their crosstalk to DNA epigenetic Modifications',
    award: 'UG3NS132105',
    url: 'https://reporter.nih.gov/search/3lX5NIPrRUyAS0UIubGs0A/projects',
    logo: 'BaylorCollegeofMedicine.png',
  },
  {
    component: 'Tool and Technology Development',
    awardee: 'Alexander Urban',
    institution: 'Stanford University',
    title:
      'Establishing and benchmarking advanced methods to comprehensively characterize somatic genome variation in single human cells',
    award: 'UG3NS132146',
    url: 'https://reporter.nih.gov/search/FPaJwQDxcUCF3e0F4R07mg/projects',
    logo: 'Stanford.png',
  },
  {
    component: 'Tool and Technology Development',
    awardee: 'Christopher Walsh (Contact) and Peter Park',
    institution: "Boston Children's Hospital",
    title:
      'Development of an Efficient High Throughput Technique for the Identification of High-Impact Non-Coding Somatic Variants Across Multiple Tissue Types',
    award: 'UG3NS132138',
    url: 'https://reporter.nih.gov/search/k6349gvQ306pH-tHWoH9fQ/projects',
    logo: 'BostonChildrens.png',
  },
  {
    component: 'Tool and Technology Development',
    awardee: 'Chenghang Zong',
    institution: 'Baylor College of Medicine',
    title:
      'Develop accurate high-coverage and high-throughput single-cell Duplex-seq chemistry and multi-omics platforms for simultaneous profiling of somatic mutation and the transcriptome in single human cells',
    award: 'UG3NS132132',
    url: 'https://reporter.nih.gov/search/zKjvlITUGEytz3hEsg4gcQ/projects',
    logo: 'BaylorCollegeofMedicine.png',
  },
];

const cols = 'md:grid md:grid-cols-[1.1fr_1.4fr_1.3fr_2fr_1fr_1.25rem] md:gap-4';
---

<Layout {meta}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-6xl">
    <h1 class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter">Awardees</h1>
    <p class="mt-8 text-lg">
      The following table details the awardees for the SMaHT Network. Select a row to learn more about each awardee.
    </p>

    <div class="mt-6 text-sm md:text-base">
      <div class={`hidden ${cols} font-semibold border-b-2 border-gray-300 dark:border-slate-600 pb-2`}>
        <div>Component</div>
        <div>Awardee</div>
        <div>Institution</div>
        <div>Title</div>
        <div>Award Number</div>
        <div></div>
      </div>
      {
        awardees.map((a) => (
          <details class="awardee group border-b border-gray-200 dark:border-slate-700">
            <summary class={`${cols} grid grid-cols-1 gap-1 py-3 cursor-pointer list-none hover:bg-blue-50 dark:hover:bg-slate-800`}>
              <div class="font-semibold md:font-normal">{a.component}</div>
              <div>{a.awardee}</div>
              <div>{a.institution}</div>
              <div>{a.title}</div>
              <div>
                <a href={a.url} target="_blank" rel="noopener" class="text-blue-600 dark:text-blue-400 underline">
                  {a.award}
                </a>
              </div>
              <div class="hidden md:block text-gray-400 transition-transform group-open:rotate-180" aria-hidden="true">
                ▾
              </div>
            </summary>
            <div class="flex flex-col sm:flex-row gap-6 items-start sm:items-center pb-6 pt-2">
              {a.logo && (
                <img
                  src={`/images/institutions/${a.logo}`}
                  alt={`${a.institution} logo`}
                  class="w-28 h-28 object-contain flex-shrink-0"
                  loading="lazy"
                />
              )}
              {a.description && <p class="text-base">{a.description}</p>}
            </div>
          </details>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .awardee summary::-webkit-details-marker {
    display: none;
  }
</style>
